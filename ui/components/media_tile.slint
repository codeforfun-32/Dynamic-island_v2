import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { IconButton, Chip, Icon } from "controls.slint";

export struct SourceItem {
    key: string,
    label: string,
    active: bool,
}

export component MediaTile inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> source-name;
    in property <bool> playing;
    in property <bool> has-media;
    in property <float> progress;
    in property <[float]> viz;
    callback prev();
    callback toggle();
    callback next();
    callback seek(float);
    callback source-tapped();
    callback title-tapped();

    // title: click it to open what is playing
    Text {
        x: 0px;
        y: 0px;
        width: parent.width - 108px;
        height: 22px;
        text: root.has-media ? root.track-title : "Nothing playing";
        color: (tt.has-hover && root.has-media) ? Theme.accent : Theme.text;
        font-size: 16px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
        animate color { duration: 140ms; }
    }
    if root.has-media && tt.has-hover : Icon {
        x: parent.width - 126px;
        y: 3px;
        width: 15px;
        height: 15px;
        d: Icons.link;
        tint: Theme.accent;
    }
    tt := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width - 108px;
        height: 22px;
        enabled: root.has-media;
        mouse-cursor: pointer;
        clicked => { root.title-tapped(); }
    }

    Text {
        x: 0px;
        y: 24px;
        width: parent.width - 72px;
        height: 16px;
        text: root.has-media ? root.track-artist : "Play something to see it here";
        color: Theme.text-dim;
        font-size: 12px;
        overflow: elide;
        vertical-alignment: center;
    }

    // which player is being controlled (tap to change)
    Rectangle {
        x: parent.width - 86px;
        y: 0px;
        width: 86px;
        height: 22px;
        border-radius: 11px;
        background: st.has-hover ? Theme.chip-active : Theme.chip;
        animate background { duration: 140ms; }

        Text {
            x: 9px;
            y: 0px;
            width: parent.width - 26px;
            height: parent.height;
            text: root.source-name == "" ? "No player" : root.source-name;
            color: Theme.text;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
        Path {
            x: parent.width - 16px;
            y: 9px;
            width: 8px;
            height: 5px;
            viewbox-width: 8;
            viewbox-height: 5;
            commands: "M 0 0 L 8 0 L 4 5 Z";
            fill: Theme.text-dim;
        }
        st := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.source-tapped(); }
        }
    }

    // mini visualizer of what is playing
    Rectangle {
        x: parent.width - 60px;
        y: 26px;
        width: 60px;
        height: 20px;
        opacity: root.playing ? 1 : 0.25;
        animate opacity { duration: 200ms; }

        for b[i] in root.viz : Rectangle {
            x: i * 7px;
            y: (parent.height - self.height) / 2;
            width: 4px;
            height: Math.max(3px, b * 20px);
            border-radius: 2px;
            background: Theme.accent;
            animate height { duration: 80ms; }
        }
    }

    Rectangle {
        x: 0px;
        y: 52px;
        width: parent.width;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.progress;
            height: parent.height;
            border-radius: 3px;
            background: Theme.accent;
            animate width { duration: 250ms; easing: linear; }
        }

        // click anywhere on the bar to jump to that position
        TouchArea {
            x: 0px;
            y: -8px;
            width: parent.width;
            height: parent.height + 16px;
            mouse-cursor: pointer;
            clicked => { root.seek(self.mouse-x / self.width); }
        }
    }

    HorizontalLayout {
        x: 0px;
        y: 72px;
        width: parent.width;
        height: 36px;
        alignment: center;
        spacing: 14px;

        IconButton { kind: 0; clicked => { root.prev(); } }
        IconButton { kind: root.playing ? 2 : 1; clicked => { root.toggle(); } }
        IconButton { kind: 3; clicked => { root.next(); } }
    }
}

export component SourcePicker inherits Rectangle {
    in property <[SourceItem]> items;
    callback picked(string);
    callback back();

    Text {
        x: 0px;
        y: 0px;
        width: parent.width - 64px;
        height: 20px;
        text: "Control which player?";
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }

    Chip {
        x: parent.width - 56px;
        y: 0px;
        width: 56px;
        height: 20px;
        text: "Back";
        clicked => { root.back(); }
    }

    VerticalLayout {
        x: 0px;
        y: 24px;
        width: parent.width;
        spacing: 3px;
        alignment: start;

        for item in root.items : Rectangle {
            height: 19px;
            border-radius: 8px;
            background: (item.active || row.has-hover) ? Theme.chip-active : Theme.chip;
            animate background { duration: 120ms; }

            Text {
                x: 10px;
                y: 0px;
                width: parent.width - 30px;
                height: parent.height;
                text: item.label;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }

            Rectangle {
                x: parent.width - 16px;
                y: 6px;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.accent;
                opacity: item.active ? 1 : 0;
            }

            row := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(item.key); }
            }
        }
    }
}